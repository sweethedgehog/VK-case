# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Для быстрого запуска без загрузки модели с Hugging Face.
# keyword = поиск по словам/алиасам; auto = попытаться использовать embeddings и fallback при ошибке.
SEARCH_MODE=keyword
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K_CHUNKS=7
MAX_CONTEXT_CHARS=14000

API_REQUESTS_PER_MINUTE=15
MAX_QUESTION_CHARS=1500
API_INTERNAL_TOKEN=
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
